# QuizCraft Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_ENV=production
APP_NAME=QuizCraft
APP_LOG_LEVEL=info

# ==========================================
# SERVER SETTINGS
# ==========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ==========================================
# DATABASE SETTINGS
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=quiz_craft
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# ==========================================
# JWT SETTINGS
# ==========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE
JWT_ACCESS_TOKEN_EXPIRE=24      # Hours
JWT_REFRESH_TOKEN_EXPIRE=720    # Hours (30 days)

# ==========================================
# EMAIL SETTINGS (SMTP)
# ==========================================
# Use your email service provider's SMTP settings
# Examples:
#   - Gmail: smtp.gmail.com:587
#   - SendGrid: smtp.sendgrid.net:587
#   - AWS SES: email-smtp.us-east-1.amazonaws.com:587
#   - Mailgun: smtp.mailgun.org:587

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey_or_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@quizcraft.com
EMAIL_FROM_NAME=QuizCraft

# ==========================================
# AI SETTINGS (Optional)
# ==========================================
# OpenAI API Key for AI quiz generation
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==========================================
# FRONTEND SETTINGS
# ==========================================
# Used in email links for email verification, password reset, etc.
FRONTEND_URL=https://quizcraft.com

# ==========================================
# REDIS SETTINGS (Optional)
# ==========================================
# For caching and rate limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ==========================================
# SECURITY SETTINGS
# ==========================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://quizcraft.com,https://www.quizcraft.com

# Rate limiting (requests per minute)
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=100

# ==========================================
# FILE UPLOAD SETTINGS
# ==========================================
# Maximum file size in MB
MAX_FILE_SIZE=10

# Allowed file types for quiz generation
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# ==========================================
# MONITORING & LOGGING
# ==========================================
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Log file location
LOG_FILE_PATH=/app/logs/quizcraft.log

# ==========================================
# BACKUP SETTINGS
# ==========================================
# S3 or compatible storage for backups (optional)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features
FEATURE_AI_GENERATION=true
FEATURE_FILE_UPLOAD=true
FEATURE_TEMPLATES=true
FEATURE_SHARING=true

# ==========================================
# ADMIN SETTINGS
# ==========================================
# Initial admin user (created on first run)
ADMIN_EMAIL=admin@quizcraft.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Admin User

# ==========================================
# NOTES
# ==========================================
# 1. Never commit this file with real credentials
# 2. Generate strong random passwords for all services
# 3. Use environment-specific values for each deployment
# 4. Consider using a secrets management service (AWS Secrets Manager, HashiCorp Vault)
# 5. Rotate passwords and secrets regularly
